  <description>Offline UR10 assembly MoveIt2/RViz2 package with ros2_control mock hardware.</description>
  <maintainer email="dev@example.com">ur10_dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
