<?xml version="1.0"?>
<package format="3">
  <name>ur10_dynamics_measurement</name>
  <version>0.1.0</version>
  <description>ROS2 GUI for measuring UR10 estimated torque (from motor currents) versus real FT300 wrench (via Jacobian transpose).</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>python3-pykdl</depend>
  <depend>python3-numpy</depend>
  <depend>python3-pyqt5</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
